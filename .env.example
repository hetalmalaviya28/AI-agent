# ─────────────────────────────────────────────────
#  VidyAI – Environment Variables
# ─────────────────────────────────────────────────

# Groq API key  (get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use  (llama-3.3-70b-versatile | llama3-70b-8192 | mixtral-8x7b-32768 | gemma2-9b-it)
GROQ_MODEL=llama-3.3-70b-versatile

# Flask secret key (generate a random string for production)
SECRET_KEY=change-this-in-production-use-a-random-string

# Environment (development | production)
FLASK_ENV=development

# Debug mode (True | False)
FLASK_DEBUG=True
